# Copy this file only as a template. Generate real values with:
# bash scripts/init-production-env.sh
# Never use these example values on a public server.

APP_ENV=production
DOMAIN=video.example.com
ACME_EMAIL=admin@example.com # used by host Certbot, not Docker

SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=youtube
POSTGRES_USER=youtube
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-secret
DATABASE_URL=postgresql+psycopg://youtube:replace-with-a-random-64-character-hex-secret@db:5432/youtube

MINIO_IMAGE=ghcr.io/seaweedfs/minio-compat:latest
MINIO_ROOT_USER=youtube-storage
MINIO_ROOT_PASSWORD=replace-with-a-random-64-character-hex-secret
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=youtube-storage
S3_SECRET_KEY=replace-with-a-random-64-character-hex-secret

REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=replace-with-a-random-64-character-hex-secret
REDIS_URL=redis://:replace-with-a-random-64-character-hex-secret@redis:6379/0

VIEW_DEDUP_TTL_SECONDS=1800
