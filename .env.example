APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_DB=youtube
POSTGRES_USER=youtube
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+psycopg://youtube:change-this-postgres-password@db:5432/youtube

MINIO_ROOT_USER=youtube-storage
MINIO_ROOT_PASSWORD=change-this-minio-password
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=youtube-storage
S3_SECRET_KEY=change-this-minio-password
REDIS_URL=redis://redis:6379/0
